{
  "name": "kingjames",
  "version": "0.0.17",
  "description": "A King James Bible search library, currently no database requried",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "test": "jest --watch",
    "test:cov": "jest --coverage",
    "test:ci": "jest --ci --reporters='default' --reporters='./.github/reporters/github-actions-reporter'",
    "build": "prisma generate && prisma db push && prisma db seed && rm -rf ./dist && tsc && mkdir ./dist/prisma && cp ./src/prisma/schema.prisma ./dist/prisma/schema.prisma",
    "prepublish": "tsc"
  },
  "keywords": [],
  "author": "Robert Crossland",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "fp-ts": "^2.16.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.10",
    "jest": "^29.7.0",
    "prisma": "^6.2.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testPathIgnorePatterns": [
      "dist"
    ]
  },
  "prisma": {
    "seed": "ts-node ./src/seed/seed.ts",
    "schema": "./src/prisma/schema.prisma"
  }
}
